<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1"
             xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">

    <persistence-unit name="acaiteria" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>br.edu.ufersa.projeto9poo.models.entities.Adicional</class>
        <class>br.edu.ufersa.projeto9poo.models.entities.Administrador</class>
        <class>br.edu.ufersa.projeto9poo.models.entities.Cliente</class>
        <class>br.edu.ufersa.projeto9poo.models.entities.Funcionario</class>
        <class>br.edu.ufersa.projeto9poo.models.entities.Pedido</class>
        <class>br.edu.ufersa.projeto9poo.models.entities.Pedido</class>
        <class>br.edu.ufersa.projeto9poo.models.entities.Produto</class>
        <class>br.edu.ufersa.projeto9poo.models.entities.ProdutoPedido</class>

        <properties>
            <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="javax.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/acaiteria "/>
            <property name="javax.persistence.jdbc.user" value="admin"/>
            <property name="javax.persistence.jdbc.password" value="admin"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>

            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>