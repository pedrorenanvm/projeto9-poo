<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane fx:id="anchorPane" prefHeight="768.0" prefWidth="1158.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.edu.ufersa.projeto9poo.controller.TrocarSenhaController">
    <children>
        <GridPane layoutX="479.0" layoutY="325.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Label text="Senha antiga"/>
                <Label text="nova senha" GridPane.rowIndex="1"/>
                <Label text="verificar" GridPane.rowIndex="2"/>
                <PasswordField fx:id="inputSenhaAntiga" GridPane.columnIndex="1"/>
                <PasswordField fx:id="inputSenhaNova" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <PasswordField fx:id="inputVerificar" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </children>
        </GridPane>
        <Button layoutX="554.0" layoutY="430.0" mnemonicParsing="false" onAction="#trocarSenha" text="Trocar"/>
    </children>
</AnchorPane>
