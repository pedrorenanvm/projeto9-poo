<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1158.0" style="-fx-background-color: #1a1a1a;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ufersa.projeto9poo.controller.CarrinhoController">

    <left>
        <VBox prefHeight="768.0" prefWidth="712.0" spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <VBox spacing="5">
                <Label text="Buscar por Data:" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font></Label>
                <DatePicker fx:id="filtroData" />

                <Label text="Buscar por Produto:" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font></Label>
                <TextField fx:id="filtroProduto" promptText="Digite o nome do produto" />

                <Label text="Buscar por Cliente:" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font></Label>
                <TextField fx:id="filtroCliente" promptText="Digite o nome do cliente" />

                <Button fx:id="btnBuscar" onAction="#buscarCarrinhos" style="-fx-background-color: #8A2BE2; -fx-background-radius: 5;" text="Buscar" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
            </VBox>

            <TableView fx:id="tabelaCarrinhos" prefHeight="400" prefWidth="591.0">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                    <TableColumn fx:id="colCliente" prefWidth="120.0" text="Cliente" />
                    <TableColumn fx:id="colData" prefWidth="120.0" text="Data" />
                    <TableColumn fx:id="colItens" prefWidth="75.0" text="Itens" />
                    <TableColumn fx:id="colPagamento" prefWidth="120.0" text="Pagamento" />
                    <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
                    <TableColumn fx:id="colValorTotal" prefWidth="120.0" text="Total (R$)" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="btnNota" onAction="#abrirNota" style="-fx-background-color: #8A2BE2; -fx-background-radius: 5;" text="Nota" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
                <Button fx:id="btnEditar" style="-fx-background-color: #8A2BE2; -fx-background-radius: 5;" text="Editar" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
                <Button fx:id="btnExcluir" style="-fx-background-color: red; -fx-background-radius: 5;" text="Excluir" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
            </HBox>
        </VBox>
    </left>

    <center>
        <VBox prefHeight="768.0" prefWidth="554.0" spacing="10" style="-fx-background-color: #fff; -fx-border-radius: 10px; -fx-background-radius: 10px;">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Label prefHeight="26.0" prefWidth="288.0" style="-fx-font-size: 16px; -fx-font-weight: bold" text="Cadastro / Edição de Carrinho">
            <font>
               <Font name="System Bold" size="18.0" />
            </font></Label>

            <Label text="Cliente:">
            <font>
               <Font name="System Bold" size="14.0" />
            </font></Label>
            <ComboBox fx:id="comboCliente" promptText="Selecione o cliente" />

            <Label text="Tipo de Pagamento:">
            <font>
               <Font name="System Bold" size="14.0" />
            </font></Label>
            <ComboBox fx:id="comboPagamento" promptText="Selecione o tipo de pagamento" />

            <Label text="Estado do Carrinho:">
            <font>
               <Font name="System Bold" size="14.0" />
            </font></Label>
            <ComboBox fx:id="comboEstado" promptText="Selecione o estado" />

            <Label text="Produto:">
            <font>
               <Font name="System Bold" size="14.0" />
            </font></Label>
            <ComboBox fx:id="comboProduto" promptText="Selecione o produto" />

            <Label text="Adicionais:">
            <font>
               <Font name="System Bold" size="14.0" />
            </font></Label>
            <ListView fx:id="listaAdicionais" editable="false" prefHeight="100" />

            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="5">
                    <Label text="Quantidade:">
                  <font>
                     <Font name="System Bold" size="14.0" />
                  </font></Label>
                    <Spinner fx:id="spinnerQuantidade" editable="true" prefWidth="120" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Preço unitário (R$):">
                  <font>
                     <Font name="System Bold" size="14.0" />
                  </font></Label>
                    <TextField fx:id="txtPrecoUnidade" prefWidth="120" promptText="ex: 12,50" />
                </VBox>
            </HBox>

            <Button fx:id="btnAdicionarCarrinho" onAction="#adicionarItemCarrinho" style="-fx-background-color: #8A2BE2;" text="Adicionar Item ao Carrinho" textFill="WHITE">
            <font>
               <Font name="System Bold" size="14.0" />
            </font></Button>

            <Label text="Itens do Carrinho:">
            <font>
               <Font name="System Bold" size="14.0" />
            </font></Label>
            <TableView fx:id="tabelaItens" prefHeight="200" prefWidth="721.0">
                <columns>
                    <TableColumn fx:id="colProdutoItem" prefWidth="101.59997403621674" text="Produto" />
                    <TableColumn fx:id="colAdicionaisItem" prefWidth="120.00000762939453" text="Adicionais" />
                    <TableColumn fx:id="colQuantidadeItem" prefWidth="96.00006103515625" text="Qtd" />
                    <TableColumn fx:id="colPrecoUnitarioItem" prefWidth="184.800048828125" text="Unit (R$)" />
                    <TableColumn fx:id="colPrecoTotalItem" prefWidth="110" text="Total (R$)" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="btnRemoverItem" style="-fx-background-color: red; -fx-background-radius: 5;" text="Remover item selecionado" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-background-color: #bcbcbc;">
                <Label fx:id="appError" />
                <Button fx:id="btnSalvarCarrinho" onAction="#salvarCarrinho" style="-fx-background-color: #8A2BE2; -fx-background-radius: 5;" text="Salvar Carrinho" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
                <Button fx:id="btnCancelarCarrinho" onAction="#cancelarEdicao" style="-fx-background-color: red; -fx-background-radius: 5;" text="Cancelar" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
            </HBox>
        </VBox>
    </center>

</BorderPane>
