<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.edu.ufersa.projeto9poo.controller.FuncionarioController">
    <children>
        <TableView fx:id="table" layoutX="14.0" layoutY="14.0" prefHeight="373.0" prefWidth="200.0"
                   AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
            <columns>
                <TableColumn fx:id="tableId" prefWidth="75.0" text="id"/>
                <TableColumn fx:id="tableUsuario" prefWidth="124.0" text="usuario"/>
            </columns>
        </TableView>
        <GridPane alignment="CENTER" layoutX="300.0" layoutY="270.0" AnchorPane.leftAnchor="300.0"
                  AnchorPane.topAnchor="270.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Label text="id"/>
                <Label text="usuario" GridPane.rowIndex="1"/>
                <Label fx:id="labelId" GridPane.columnIndex="1"/>
                <TextField fx:id="inputUsuario" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </children>
        </GridPane>
        <GridPane layoutX="258.0" layoutY="296.0" prefHeight="28.0" prefWidth="271.0" AnchorPane.bottomAnchor="20.0"
                  AnchorPane.rightAnchor="20.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Button mnemonicParsing="false" onAction="#criar" text="Criar" GridPane.halignment="CENTER"
                        GridPane.valignment="CENTER"/>
                <Button mnemonicParsing="false" onAction="#resetarSenha" text="resetar senha" GridPane.columnIndex="1"
                        GridPane.halignment="CENTER"/>
                <Button mnemonicParsing="false" onAction="#deletar" text="Deletar" GridPane.columnIndex="2"
                        GridPane.halignment="CENTER"/>
            </children>
        </GridPane>
    </children>
</AnchorPane>
